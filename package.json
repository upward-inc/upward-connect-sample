{
  "name": "multi-platform-sample",
  "version": "1.0.0",
  "scripts": {
    "dev": "bun run --filter api dev",
    "db#up": "bun run --filter api db#up",
    "db#down": "bun run --filter api db#down",
    "db#init": "bun run --filter api db#init",
    "db#seed": "bun run --filter api db#seed",
    "prisma#generate": "bun run --filter api prisma#generate"
  },
  "workspaces": ["apps/*"]
}