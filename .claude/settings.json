{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Bash(sudo *)",
			"Bash(chmod 777 *)",
			"Bash(git add .)",
			"Bash(git add -A)",
			"Bash(git push -f *)",
			"Bash(git push --force *)",
			"Bash(git reset --hard *)",
			"Bash(git checkout .)",
			"Bash(git clean -f *)",
			"Bash(git branch -D *)",
			"Bash(git stash drop *)",
			"Bash(git -C *)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(.npmrc)",
			"Read(id_rsa)",
			"Read(id_ed25519)",
			"Read(*.pem)",
			"Bash(*dotenvx*)",
			"Bash(*gitleaks*)"
		],
		"ask": [
			"Bash(*--force*)",
			"Bash(*--force-with-lease*)",
			"Bash(*prune*)",
			"Bash(*migrate*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun .claude/hooks/guard-rm-outside-project.ts"
					},
					{
						"type": "command",
						"command": "bun .claude/hooks/validate-and-redirect-bash.ts"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(Edit|Write)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun .claude/hooks/lint-and-format.ts"
					}
				]
			}
		]
	}
}
