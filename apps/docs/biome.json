{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"extends": ["../../biome.json"],
	"files": {
		"includes": [
			"**/src/**/*.ts",
			"**/src/**/*.mjs",
			"**/astro.config.mjs",
			"!**/.astro",
			"!**/*.astro"
		]
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		},
		"linter": {
			"enabled": false
		}
	}
}
