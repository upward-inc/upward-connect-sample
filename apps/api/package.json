{
	"name": "api",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"db#up": "docker compose -f compose-db.yml up -d",
		"db#down": "docker compose -f compose-db.yml down",
		"db#init": "prisma migrate dev --name init",
		"db#seed": "bun run seed/index.ts",
		"prisma#generate": "prisma generate",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write"
	},
	"dependencies": {
		"@formkit/tempo": "^0.1.2",
		"@hono/zod-validator": "^0.5.0",
		"@prisma/client": "^6.7.0",
		"@scalar/hono-api-reference": "^0.8.8",
		"hono": "^4.7.9",
		"hono-openapi": "^0.4.8",
		"jsonwebtoken": "^9.0.2",
		"zod": "^3.24.4",
		"zod-openapi": "^4.2.4"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/jsonwebtoken": "^9.0.9",
		"prisma": "^6.7.0"
	}
}
