  end_date_time          DateTime? @db.DateTime
  is_all_day_event       Boolean   @default(false, map: "df_activity_is_all_day_event")
  actual_start_date_time DateTime? @db.DateTime
  actual_end_date_time   DateTime? @db.DateTime
  status                 String?   @db.NVarChar(Max)
  location               String?   @db.NVarChar(256)
  required_attendees     String?   @db.NVarChar(Max)
  optional_attendees     String?   @db.NVarChar(Max)
  organizer              String?   @db.NVarChar(Max)
  meeting_url            String?   @db.NVarChar(Max)
  description            String?   @db.NVarChar(Max)
  start_latitude         Decimal?  @db.Decimal(18, 15)
  start_longitude        Decimal?  @db.Decimal(18, 15)
  finish_latitude        Decimal?  @db.Decimal(18, 15)
  finish_longitude       Decimal?  @db.Decimal(18, 15)
