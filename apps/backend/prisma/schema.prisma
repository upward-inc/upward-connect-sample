  working_longitude      Decimal?  @db.Decimal(18, 15)
  is_archived            Boolean   @default(false, map: "df_activity_is_archived")
  is_deleted             Boolean   @default(false, map: "df_activity_is_deleted")
  owner                  String    @db.NVarChar(Max)
  created_at             DateTime  @default(dbgenerated("getutcdate()"), map: "df_activity_created_at")
  created_by             String    @db.NVarChar(Max)
  modified_at            DateTime  @default(dbgenerated("getutcdate()"), map: "df_activity_modified_at")
  modified_by            String    @db.NVarChar(Max)
}

model campaign {
