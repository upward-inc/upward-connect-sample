generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model account {
  id                   String                    @id(map: "pk_account") @default(dbgenerated("newid()"), map: "df_account_id") @db.UniqueIdentifier
  name                 String                    @db.NVarChar(256)
  account_number       String?                   @db.NVarChar(20)
  main_phone_number    String?                   @db.NVarChar(50)
  sub_phone_number     String?                   @db.NVarChar(50)
  website              String?                   @db.NVarChar(Max)
  industry             String?                   @db.NVarChar(Max)
  number_of_employees  Decimal?                  @db.Decimal(6, 0)
  revenue              Decimal?                  @db.Decimal(16, 0)
  address_zipcode      String?                   @db.NVarChar(20)
  address_prefecture   String?                   @db.NVarChar(256)
  address_municipality String?                   @db.NVarChar(256)
  address_street       String?                   @db.NVarChar(256)
  location             Unsupported("geography")?
  market_cap           Decimal?                  @db.Decimal(16, 0)
  description          String?                   @db.NVarChar(Max)
  originating_lead     String?                   @db.NVarChar(Max)
  parent               String?                   @db.NVarChar(Max)
  is_deleted           Boolean                   @default(false, map: "df_account_is_deleted")
  owner                String                    @db.NVarChar(Max)
  created_at           DateTime                  @default(dbgenerated("getutcdate()"), map: "df_account_created_at")
  created_by           String                    @db.NVarChar(Max)
  modified_at          DateTime                  @default(dbgenerated("getutcdate()"), map: "df_account_modified_at")
  modified_by          String                    @db.NVarChar(Max)
}

model activity {
  id                     String    @id(map: "pk_activity") @default(dbgenerated("newid()"), map: "df_activity_id") @db.UniqueIdentifier
