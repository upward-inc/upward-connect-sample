{
	"name": "backend",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"test": "vitest run --config vitest.config.ts",
		"db#up": "docker compose -f compose-db.yml up -d",
		"db#down": "docker compose -f compose-db.yml down",
		"db#migrate": "prisma migrate dev",
		"db#pull": "prisma db pull",
		"db#migratefile": "dir=$(mkdir -p prisma/migrations/$(date +%Y%m%d%H%M%S) && echo $_) && cp ./migration.template.sql $dir/migration.sql",
		"db#seed": "bun run seed/index.ts",
		"prisma#generate": "bun --env-file=.env run prisma generate",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "biome check --write"
	},
	"dependencies": {
		"@formkit/tempo": "^1.1.0",
		"@hono/zod-openapi": "^1.4.0",
		"@prisma/adapter-mssql": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@scalar/hono-api-reference": "^0.10.16",
		"hono": "^4.12.21",
		"jsonwebtoken": "^9.0.3",
		"nanoid": "^5.1.11",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@testcontainers/mssqlserver": "^11.14.0",
		"@types/bun": "latest",
		"@types/jsonwebtoken": "^9.0.10",
		"@vitest/ui": "^4.1.7",
		"prisma": "^7.8.0",
		"vitest": "^4.1.7"
	}
}
